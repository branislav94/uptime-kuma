# --- Uptime Kuma login (the account you create in the Kuma UI on first start) ---
# Note: the Kuma "API key" from the UI does NOT work for this — use user/pass (no 2FA).
KUMA_USER=admin
KUMA_PASS=change-me
# Kuma API timeout in seconds
KUMA_TIMEOUT=120

# --- WHM servers: name|url|api_token, multiple servers separated by commas ---
# Token: WHM > Development > Manage API Tokens (create one ON EACH server, as root)
WHM_SERVERS=cp1|https://cp1.example.com:2087|TOKEN_FOR_CP1
WHM_VERIFY_SSL=true

# --- Phone notifications (ntfy) ---
# 1) Install the "ntfy" app (Android / iOS)
# 2) In the app: + > Subscribe to topic > enter EXACTLY the same name as here
# On ntfy.sh the topic name is the only "password" — make it long and random!
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC_SITES=sites-CHANGE-to-something-random
NTFY_TOPIC_INFRA=infra-CHANGE-to-something-random
# Domain and SSL expiry (empty = goes to NTFY_TOPIC_SITES)
NTFY_TOPIC_EXPIRY=domains-CHANGE-to-something-random
# Priority 1-5. An outage is sent at +1 (sites 3 -> 4). Infra 5 = loud, can bypass Do Not Disturb if allowed in the app
NTFY_PRIORITY_SITES=3
NTFY_PRIORITY_INFRA=5
# Only if you use your own ntfy server or an ntfy.sh account with a token
NTFY_TOKEN=
# Additional Kuma notifications (IDs, comma separated). Empty = the ones marked "Default enabled" in Kuma
NOTIFICATION_IDS=

# --- What to monitor ---
# Domain types: main, addon, parked, sub (addon/sub/parked get a tag in Kuma)
DOMAIN_TYPES=main,addon,parked,sub
# Skip suspended cPanel accounts
SKIP_SUSPENDED=true
# Domains/patterns to skip (fnmatch, comma separated)
EXCLUDE=*.cpanel.site,*.temp.*
# What to do with a monitor when its domain disappears from the server: pause | delete | keep
ON_REMOVED=pause

# --- DNS check: only monitor domains that actually point to our server ---
# ours = A record must be a server IP (or Cloudflare) | resolves = must exist | off = no check
DNS_CHECK=ours
DNS_ALLOW_CLOUDFLARE=true
# Extra IPs that count as "ours" (e.g. the public IP when a cPanel VM has a private one behind NAT)
SERVER_IPS=

# --- Site monitor settings ---
MONITOR_INTERVAL=300
# alert only after 3 failed retries 60s apart (~3-4 min of downtime)
MONITOR_RETRIES=3
RETRY_INTERVAL=60
# Content: the monitor is DOWN if the page contains this text (even with HTTP 200). Empty = disabled
CONTENT_ERROR_KEYWORD=Fatal error
# The sync keeps the settings above on all its monitors (manually added status codes are NOT touched)
ENFORCE_SETTINGS=true

# --- Domain expiry (RDAP, WHOIS for .rs/.io and other TLDs without RDAP) ---
DOMAIN_EXPIRY=true
# Phone alert when this many days are left
DOMAIN_EXPIRY_DAYS=30,14,7,3,1
EXPIRY_CHECK_HOURS=24

# --- SSL certificates (the sync checks the certificate the site actually serves) ---
# AutoSSL renews ~30 days before expiry, so an alert at 14 days means renewal is FAILING.
# When enabled, Kuma's built-in SSL alert is turned off (no duplicate messages).
SSL_CHECK=true
SSL_EXPIRY_DAYS=14,7,3,1

# --- Infrastructure ---
# Nested groups in Kuma:
#   Websites / <server> / <cPanel account>        (sites, automatic)
#   Infrastructure / cPanel / <server>           (automatic, from WHM_SERVERS)
#   Infrastructure / Proxmox / <node>            (PROXMOX_NODES)
#   Infrastructure / DNS                         (NAMESERVERS)
#   Infrastructure / <your group>                (INFRA_EXTRA, default "Other")
INFRA_INTERVAL=60
INFRA_RETRIES=2
INFRA_RETRY_INTERVAL=30
# Infra monitors removed from config: pause | delete
INFRA_ON_REMOVED=pause

# cPanel servers: ping, WHM 2087, cPanel 2083, Webmail 2096 + these ports
INFRA_AUTO=true
# 25 is left out because home/business ISPs often block it outbound
INFRA_AUTO_PORTS=465,587,993,21
# Per-server override (name from WHM_SERVERS, uppercase, non-alphanumerics -> _), e.g.:
# INFRA_PORTS_CP2=465,993

# Proxmox nodes: name|host — ping + Proxmox UI (8006) + PROXMOX_PORTS
# PROXMOX_NODES=Node102|1.2.3.4,Node103|5.6.7.8
PROXMOX_NODES=
# Extra ports for every node (e.g. 22 for SSH, 8007 for PBS); per-node override PROXMOX_PORTS_<NAME>
PROXMOX_PORTS=
# PROXMOX_PORTS_NODE103=22,8007

# Nameservers: checks that they answer for DNS_TEST_DOMAIN
NAMESERVERS=
DNS_TEST_DOMAIN=example.com

# Extra monitors, separated by ";"  —  name|type|target[|group]
#   type: http | http-insecure (self-signed) | port (host:port) | ping | dns (domain@resolver-ip)
#   group (optional): path under Infrastructure, e.g. "Game" or "Game/Wings" (default "Other")
# Example:
# INFRA_EXTRA=Pterodactyl|http|https://panel.example.com|Game;Wings 1|port|1.2.3.4:8080|Game/Wings
INFRA_EXTRA=
# Uplink check (where Kuma runs). If these are down, site outages are false alarms.
INTERNET_CHECK=1.1.1.1,8.8.8.8

# --- Status pages (Kuma: /status/<slug>) ---
STATUS_PAGES=true
# Labels on the pages: en | sr
STATUS_LANG=en
# Public page: services only (web hosting, email, DNS + extras). No client sites, nodes or IPs.
STATUS_PUBLIC_SLUG=status
STATUS_PUBLIC_TITLE=Service status
# Shown under the title — a coarse location is enough (no node names, DCs or IPs)
STATUS_PUBLIC_DESCRIPTION=Hetzner · Falkenstein, Germany (EU)
# Custom domain(s) that open this page directly, e.g. status.example.com
STATUS_PUBLIC_DOMAINS=
# Extra monitors on the public page: "Monitor name|Section;..." (exact Kuma monitor names)
# STATUS_PUBLIC_EXTRA=Pterodactyl|Game hosting;WHMCS|Client area
STATUS_PUBLIC_EXTRA=
# Internal pages. Empty slug = page not created.
# Kuma 2 status pages have no password — keep these behind NetBird / Cloudflare Access!
# Infrastructure: every infra group (cPanel, Proxmox, DNS, ...)
STATUS_INTERNAL_SLUG=
STATUS_INTERNAL_TITLE=Internal status
# Client websites: all sites, one section per client (cPanel account)
STATUS_SITES_SLUG=
STATUS_SITES_TITLE=Clients Websites
# Per-client pages (cPanel usernames, comma separated, or "all"); slug = prefix + username
STATUS_CLIENT_PAGES=
STATUS_CLIENT_SLUG_PREFIX=
STATUS_CLIENT_TITLE={user} – status
STATUS_FOOTER=

# --- Sync ---
# How often the sync runs (seconds)
SYNC_INTERVAL=3600
