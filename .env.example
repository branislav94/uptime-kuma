# --- Uptime Kuma login (nalog koji napraviš u Kuma UI pri prvom pokretanju) ---
# Napomena: Kuma "API key" iz UI-ja NE radi za ovo, treba user/pass (bez 2FA).
KUMA_USER=admin
KUMA_PASS=promeni-me
# Timeout za Kuma API u sekundama
KUMA_TIMEOUT=120

# --- WHM serveri: ime|url|api_token, više servera odvojeno zarezom ---
# Token: WHM > Development > Manage API Tokens
WHM_SERVERS=cp1|https://cp1.onet.rs:2087|TOKEN_ZA_CP1
WHM_VERIFY_SSL=true

# --- Notifikacije na telefon (ntfy) ---
# 1) Instaliraj aplikaciju "ntfy" (Android / iOS)
# 2) U aplikaciji: + > Subscribe to topic > upiši TAČNO isti naziv kao ovde
# Naziv topic-a je jedina "lozinka" na ntfy.sh — neka bude dug i nasumičan!
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC_SITES=onet-sajtovi-PROMENI-u-nesto-nasumicno
NTFY_TOPIC_INFRA=onet-infra-PROMENI-u-nesto-nasumicno
# Istek domena i SSL-a (prazno = ide na NTFY_TOPIC_SITES)
NTFY_TOPIC_EXPIRY=onet-istek-PROMENI-u-nesto-nasumicno
# Prioritet: 1-5. Pad šalje +1 (sajtovi 3 -> 4). Infra 5 = glasno, probija "ne uznemiravaj" ako dozvoliš u app
NTFY_PRIORITY_SITES=3
NTFY_PRIORITY_INFRA=5
# Ako koristiš svoj ntfy server ili ntfy.sh nalog sa tokenom
NTFY_TOKEN=
# Dodatne Kuma notifikacije (ID-jevi, zarezom). Prazno = one označene "Default enabled" u Kumi
NOTIFICATION_IDS=

# --- Šta se prati ---
# Tipovi domena: main, addon, parked, sub (addon/sub/parked dobijaju tag u Kumi)
DOMAIN_TYPES=main,addon,parked,sub
# Preskoči suspendovane cPanel naloge
SKIP_SUSPENDED=true
# Domeni/obrasci koji se preskaču (fnmatch, zarezom)
EXCLUDE=*.onet.rs,*.cpanel.site,*.temp.*
# Šta raditi sa monitorom kad domen nestane sa servera: pause | delete | keep
ON_REMOVED=pause

# --- Provera DNS-a: prati samo domene koji stvarno pokazuju na naš server ---
# ours = A zapis mora biti IP servera (ili Cloudflare) | resolves = da postoji | off = bez provere
DNS_CHECK=ours
DNS_ALLOW_CLOUDFLARE=true
# Dodatne IP adrese koje se računaju kao "naše" (npr. javna IP ako cPanel VM ima privatnu)
SERVER_IPS=

# --- Podešavanja monitora sajtova ---
MONITOR_INTERVAL=300
# alarm tek posle 3 neuspela ponovljena pokušaja na po 60s (~3-4 min pada)
MONITOR_RETRIES=3
RETRY_INTERVAL=60
# Sadržaj: monitor je DOLE ako stranica sadrži ovaj tekst (čak i kad vrati 200). Prazno = isključeno
CONTENT_ERROR_KEYWORD=Fatal error
# Sync drži gornja podešavanja na svim svojim monitorima (ručno dodati status kodovi se NE diraju)
ENFORCE_SETTINGS=true

# --- Istek domena (RDAP, a WHOIS za .rs/.io i ostale bez RDAP-a) ---
DOMAIN_EXPIRY=true
# Alarm na telefon kad ostane ovoliko dana
DOMAIN_EXPIRY_DAYS=30,14,7,3,1
EXPIRY_CHECK_HOURS=24

# --- SSL sertifikati (sync proverava sertifikat koji sajt stvarno servira) ---
# AutoSSL obnavlja ~30 dana pre isteka, pa alarm na 14 dana znači da obnova NE uspeva.
# Kad je uključeno, Kumin ugrađeni SSL alarm se gasi (da ne stižu duple poruke).
SSL_CHECK=true
SSL_EXPIRY_DAYS=14,7,3,1

# --- Infrastruktura ---
# Automatski za svaki WHM server: ping, WHM 2087, cPanel 2083, Webmail 2096 + portovi ispod
INFRA_AUTO=true
# 25 je izostavljen jer ga kućni/poslovni provajderi često blokiraju ka napolje
INFRA_AUTO_PORTS=465,587,993,21
INFRA_INTERVAL=60
INFRA_RETRIES=2
INFRA_RETRY_INTERVAL=30
# Nameserveri: proverava da li odgovaraju za DNS_TEST_DOMAIN
NAMESERVERS=
DNS_TEST_DOMAIN=onet.rs
# Dodatni monitori, odvojeni sa ";"  —  ime|tip|cilj
#   tip: http | http-insecure (self-signed, npr. Proxmox) | port (host:port) | ping | dns (domen@ip-resolvera)
# Primer:
# INFRA_EXTRA=Node102 Proxmox|http-insecure|https://1.2.3.4:8006;Node103 Proxmox|http-insecure|https://5.6.7.8:8006;Node102 ping|ping|1.2.3.4
INFRA_EXTRA=
# Provera sopstvene linije (gde Kuma radi). Ako su ovi dole, padovi sajtova su lažni.
INTERNET_CHECK=1.1.1.1,8.8.8.8

# --- Sync ---
# Koliko često sync radi (sekunde)
SYNC_INTERVAL=3600
